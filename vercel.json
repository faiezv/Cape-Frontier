{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?cape-frontier\\.com" }],
      "dest": "/com/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?cape-frontier\\.com" }],
      "dest": "/com/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/coza/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/coza/index.html"
    }
  ]
}